{
  "name": "Bilge pump cycling",
  "slug": "bilge-pump-cycling",
  "message": "Bilge pump is running often",
  "signal": {
    "path": "electrical.switches.bilgePump.state"
  },
  "detector": {
    "type": "count",
    "event": {
      "op": "changesTo",
      "value": true
    },
    "window": 3600,
    "steps": [
      {
        "limit": 4,
        "priority": "warning"
      }
    ]
  }
}
