{
  "name": "signalk-alert-rules",
  "version": "0.1.0",
  "description": "Rule-based alert raiser for the Signal K alerts API: detectors, gates and zone limits.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "signalk": {
    "displayName": "Alert Rules"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-embeddable-webapp",
    "signalk-category-notifications",
    "signalk",
    "alerts",
    "alarms",
    "rules"
  ],
  "scripts": {
    "build": "npm run build:plugin && npm run build:panel",
    "build:plugin": "tsc",
    "build:panel": "vite build",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ test/ bench/",
    "lint:fix": "eslint --fix src/ test/ bench/",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"test/**/*.{ts,tsx}\" \"bench/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"test/**/*.{ts,tsx}\" \"bench/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.lint.json && tsc -p tsconfig.panel.json",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm run build:panel && npm run test",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hatlabs/signalk-alert-rules.git"
  },
  "author": "Hat Labs Oy",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/hatlabs/signalk-alert-rules/issues"
  },
  "homepage": "https://github.com/hatlabs/signalk-alert-rules#readme",
  "peerDependencies": {
    "@signalk/server-api": "^2.31.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@module-federation/vite": "^1.23.0",
    "@signalk/server-api": "^2.33.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "express": "^4.22.3",
    "jsdom": "^30.1.1",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  },
  "files": [
    "dist/",
    "public/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "signalk-plugin-enabled-by-default": false,
  "dependencies": {
    "typebox": "^1.3.34",
    "yaml": "^2.9.1"
  }
}
