{
  "name": "signalk-alert-rules",
  "version": "0.1.0",
  "description": "Rule-based alert raiser for the Signal K alerts API: detectors, gates and zone limits.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-notifications",
    "signalk",
    "alerts",
    "alarms",
    "rules"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ test/ bench/",
    "lint:fix": "eslint --fix src/ test/ bench/",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"bench/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"bench/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.lint.json",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hatlabs/signalk-alert-rules.git"
  },
  "author": "Hat Labs Oy",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/hatlabs/signalk-alert-rules/issues"
  },
  "homepage": "https://github.com/hatlabs/signalk-alert-rules#readme",
  "peerDependencies": {
    "@signalk/server-api": "^2.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@signalk/server-api": "^2.33.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "express": "^4.22.3",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "signalk-plugin-enabled-by-default": false,
  "dependencies": {
    "typebox": "^1.3.34",
    "yaml": "^2.9.1"
  }
}
